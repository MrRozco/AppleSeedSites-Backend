{
  "kind": "collectionType",
  "collectionName": "add_ons",
  "info": {
    "singularName": "add-on",
    "pluralName": "add-ons",
    "displayName": "Add-on"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "price": {
      "type": "integer",
      "min": 0
    },
    "priceSuffix": {
      "type": "enumeration",
      "enum": [
        "one-time",
        "per-month",
        "each"
      ]
    },
    "priceNote": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "link": {
      "type": "component",
      "component": "shared.link",
      "repeatable": false
    },
    "sortOrder": {
      "type": "integer",
      "default": 0
    }
  }
}
